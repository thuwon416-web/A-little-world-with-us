{
  "expo": {
    "name": "A Little World With Us",
    "slug": "a-little-world-with-us",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "alittleworldwithus",
    "description": "A relationship-first companion app for couples to chat, plan, share moments, and stay connected.",
    "privacy": "public",
    "githubUrl": "https://github.com/your-org/a-little-world-with-us",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f12"
    },
    "updates": {
      "fallbackToCacheTimeout": 0
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.alittleworldwithus.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Allow live location sharing with your partner.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow background location updates for the shared safety map.",
        "UIBackgroundModes": [
          "location"
        ],
        "NSCameraUsageDescription": "Allow camera access for video calls and taking photos or videos.",
        "NSMicrophoneUsageDescription": "Allow microphone access for voice calls and sending voice messages."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f12"
      },
      "package": "com.alittleworldwithus.app",
      "versionCode": 2,
      "permissions": [
        "INTERNET",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION",
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow location while using the app to share it with your accepted partner.",
          "locationAlwaysAndWhenInUsePermission": "Allow background location only while you have chosen to share it with your accepted partner.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      "expo-task-manager",
      "expo-notifications",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "Allow camera access for video calls.",
          "microphonePermission": "Allow microphone access for calls."
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-quick-actions"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "e408249d-9b07-4d2f-8df3-6115e4d47bab"
      }
    },
    "owner": "thuwon"
  }
}
