# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Relationship memory upload (local scripts only; never expose the service-role key)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-side cron authentication secret
# Generate 32+ char random string. Same value must be set in:
# 1. Vercel → Settings → Environment Variables
# 2. Supabase Edge Functions → Secrets
# 3. Supabase Vault (for pg_cron jobs)
CRON_SECRET=
RELATIONSHIP_MEMORIES_COUPLE_ID=your-couple-uuid

# App Configuration
NEXT_PUBLIC_APP_NAME=A Little World With Us
NEXT_PUBLIC_APP_URL=https://ourforever.app
NEXT_PUBLIC_ANNIVERSARY=2023-02-02

# Rate limiting (REQUIRED in production; use an Upstash Redis database)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# AI providers (server-side only; never use NEXT_PUBLIC_ for these values)
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
HUGGINGFACE_API_KEY=your-huggingface-api-key
NVIDIA_API_KEY=your-nvidia-api-key
CEREBRAS_API_KEY=your-cerebras-api-key
MISTRAL_API_KEY=your-mistral-api-key
COHERE_API_KEY=your-cohere-api-key
GROQ_API_KEY=your-groq-api-key
CLOUDFLARE_API_KEY=your-cloudflare-api-token
# Required only when Cloudflare Workers AI is enabled as a fallback provider.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Optional provider model overrides. Defaults are used when omitted.
# AI_GROQ_MODEL=llama-3.1-8b-instant
# AI_GEMINI_MODEL=gemini-2.0-flash

# GIF API (for chat)
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# Chat encryption key (64 hex chars = 32 bytes). Use the same existing value
# in NEXT_PUBLIC_CHAT_ENCRYPTION_KEY, CHAT_ENCRYPTION_KEY, and the mobile app.
# Generate with: openssl rand -hex 32
# NOTE: Do not rotate after messages are encrypted; older messages may no longer decrypt.
# NEXT_PUBLIC_ means the browser bundle exposes this value; it is not a private secret.
NEXT_PUBLIC_CHAT_ENCRYPTION_KEY=your-64-hex-char-key
CHAT_ENCRYPTION_KEY=your-64-hex-char-key

# Groq speech-to-text (optional; required only for the explicit voice transcript action)
# GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Error monitoring (optional)
SENTRY_DSN=your-server-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-client-sentry-dsn
# Required only when uploading source maps during production builds.
# SENTRY_ORG=your-sentry-org
# SENTRY_PROJECT=your-sentry-project
# SENTRY_AUTH_TOKEN=your-sentry-auth-token
NEXT_PUBLIC_CARTO_TILE_URL=
EXPO_PUBLIC_CARTO_STYLE_URL=

# ─────────────────────────────────────────
# Cron Migration Note (pg_cron)
# ─────────────────────────────────────────
# Vercel Hobby plan limits crons to once/day. To support */5 and */15
# schedules, migrate to Supabase pg_cron:
#   1. Enable pg_cron + pg_net extensions in Supabase
#   2. Store project_url + cron_secret in Supabase Vault
#   3. Schedule jobs (see docs/manual-queue.md section 3)
#   4. Remove vercel.json crons AFTER pg_cron verified
# ─────────────────────────────────────────
