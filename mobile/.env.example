# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GIPHY_API_KEY=your_api_key_here

# App Configuration
EXPO_PUBLIC_APP_NAME=A Little World With Us
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_CARTO_STYLE_URL=

# Use the same existing value as web NEXT_PUBLIC_CHAT_ENCRYPTION_KEY and server CHAT_ENCRYPTION_KEY.
# Generate with: openssl rand -hex 32
# NOTE: Do not rotate after messages are encrypted; older messages may no longer decrypt.
# EXPO_PUBLIC_ means this value is bundled into the mobile app; it is not a private secret.
EXPO_PUBLIC_CHAT_ENCRYPTION_KEY=your-64-hex-char-key
