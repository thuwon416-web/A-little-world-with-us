{
  "name": "a-little-world-with-us-workspace",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=24.3.0 <25"
  },
  "scripts": {
    "dev": "npm --prefix apps/web-platform/frontend run dev",
    "build": "npm --prefix apps/web-platform/frontend run build",
    "start": "npm --prefix apps/web-platform/frontend run start",
    "lint": "npm --prefix apps/web-platform/frontend run lint",
    "typecheck": "npm --prefix apps/web-platform/frontend run typecheck",
    "test": "npm --prefix apps/web-platform/frontend run test",
    "test:coverage": "npm --prefix apps/web-platform/frontend run test:coverage",
    "test:e2e": "npm --prefix apps/web-platform/frontend run test:e2e",
    "web:install": "npm --prefix apps/web-platform/frontend install",
    "mobile:install": "npm --prefix apps/mobile install",
    "mobile:dev": "npm --prefix apps/mobile run start",
    "mobile:typecheck": "npm --prefix apps/mobile run typecheck",
    "mobile:lint": "npm --prefix apps/mobile run lint",
    "mobile:test": "npm --prefix apps/mobile run test:coverage"
  }
}
