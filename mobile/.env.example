# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_GIPHY_API_KEY=your_api_key_here

# App Configuration
EXPO_PUBLIC_APP_NAME=A Little World With Us
EXPO_PUBLIC_APP_VERSION=1.0.0
EXPO_PUBLIC_CARTO_STYLE_URL=

# Chat encryption key (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
# NOTE: Changing this breaks new message decryption.
# Legacy messages still decrypt via fallback.
EXPO_PUBLIC_CHAT_ENCRYPTION_KEY=your-64-hex-char-key
