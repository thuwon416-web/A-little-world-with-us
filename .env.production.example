# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_production_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_supabase_anon_key

# App Configuration
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# Chat encryption key (64 hex chars = 32 bytes)
# Generate with: openssl rand -hex 32
# NOTE: Changing this breaks new message decryption.
# Legacy messages still decrypt via fallback.
NEXT_PUBLIC_CHAT_ENCRYPTION_KEY=your-64-hex-char-key
CHAT_ENCRYPTION_KEY=your-64-hex-char-key

# Google Drive OAuth (server-side only)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_REDIRECT_URI=https://your-domain.example/api/drive/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=your_64_hex_char_key
GOOGLE_OAUTH_STATE_SECRET=your_random_oauth_state_secret

# AI APIs
GROQ_API_KEY=your_groq_key
GEMINI_API_KEY=your_gemini_key
OPENROUTER_API_KEY=your_openrouter_key
HUGGINGFACE_API_KEY=your_huggingface_key
MISTRAL_API_KEY=your_mistral_key
COHERE_API_KEY=your_cohere_key
CEREBRAS_API_KEY=your_cerebras_key
NVIDIA_API_KEY=your_nvidia_key
CLOUDFLARE_API_KEY=your_cloudflare_key

# Notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_key
VAPID_PRIVATE_KEY=your_vapid_private_key

# Sentry (optional)
SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
NEXT_PUBLIC_SENTRY_DSN=your_public_sentry_dsn
# Required only for source-map uploads; never commit the real token.
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# Analytics (optional)
NEXT_PUBLIC_GA_ID=your_ga_id

# Optional app settings
NEXT_PUBLIC_ANNIVERSARY=
NEXT_PUBLIC_VIDEO_URLS=
NEXT_PUBLIC_COUPLE_START=
