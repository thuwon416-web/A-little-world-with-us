# ==============================================================================
# A-LITTLE-WORLD-WITH-US: PRODUCTION ENVIRONMENT CONFIGURATION (.env.production)
# Target Deployment: Vercel (Web Portal & API Routes), Supabase (PostgreSQL & Edge), Expo (Mobile)
# Architecture: 100% Standalone Decoupled Couple Intimacy Platform
# Format: [Platform / Component Target] [Variable Name]=
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VERCEL / NEXT.JS — APPLICATION & RUNTIME
# ------------------------------------------------------------------------------
# Vercel — Runtime	NODE_ENV
NODE_ENV=production

# Vercel — Runtime	PORT
PORT=3005

# Vercel — Runtime	HOST
HOST=0.0.0.0

# Vercel — Runtime	NEXT_PUBLIC_APP_URL
NEXT_PUBLIC_APP_URL=https://a-little-world-with-us.vercel.app

# Vercel — Runtime	CRON_SECRET (Generate with: openssl rand -hex 32)
CRON_SECRET=

# ------------------------------------------------------------------------------
# 2. VERCEL / SUPABASE — POSTGRESQL DATABASE & AUTHENTICATION
# ------------------------------------------------------------------------------
# Supabase — Database	DATABASE_URL (PostgreSQL pooled connection string for 56 migrations)
DATABASE_URL=

# Supabase — Auth	NEXT_PUBLIC_SUPABASE_URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase — Auth	NEXT_PUBLIC_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase — Auth	SUPABASE_SERVICE_ROLE_KEY (Server-side bypass RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. VERCEL / MOBILE — END-TO-END CHAT & MEDIA ENCRYPTION (AES-256-GCM)
# ------------------------------------------------------------------------------
# Vercel / Mobile — Encryption	NEXT_PUBLIC_CHAT_ENCRYPTION_KEY (Generate with: openssl rand -hex 32)
NEXT_PUBLIC_CHAT_ENCRYPTION_KEY=

# Vercel / Mobile — Encryption	CHAT_ENCRYPTION_KEY (Generate with: openssl rand -hex 32)
CHAT_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# 4. VERCEL / MOBILE — MULTI-STORAGE MATRIX (Cloudinary, Backblaze B2, Supabase)
# ------------------------------------------------------------------------------
# Vercel — Storage	CLOUDINARY_CLOUD_NAME
CLOUDINARY_CLOUD_NAME=

# Vercel — Storage	CLOUDINARY_API_KEY
CLOUDINARY_API_KEY=

# Vercel — Storage	CLOUDINARY_API_SECRET
CLOUDINARY_API_SECRET=

# Vercel — Storage	B2_APPLICATION_KEY_ID
B2_APPLICATION_KEY_ID=

# Vercel — Storage	B2_APPLICATION_KEY
B2_APPLICATION_KEY=

# Vercel — Storage	B2_BUCKET_ID
B2_BUCKET_ID=

# Vercel — Storage	B2_BUCKET_NAME
B2_BUCKET_NAME=little-world-media-vault

# ------------------------------------------------------------------------------
# 5. VERCEL — MULTI-PROVIDER AI ORCHESTRATION (Korean Learning & Storybook)
# ------------------------------------------------------------------------------
# Vercel — AI Providers	OPENROUTER_API_KEY
OPENROUTER_API_KEY=

# Vercel — AI Providers	GEMINI_API_KEY
GEMINI_API_KEY=

# Vercel — AI Providers	GROQ_API_KEY
GROQ_API_KEY=

# Vercel — AI Providers	MISTRAL_API_KEY
MISTRAL_API_KEY=

# Vercel — AI Providers	COHERE_API_KEY
COHERE_API_KEY=

# Vercel — AI Providers	CEREBRAS_API_KEY
CEREBRAS_API_KEY=

# Vercel — AI Providers	NVIDIA_API_KEY
NVIDIA_API_KEY=

# Vercel — AI Providers	HUGGINGFACE_API_KEY
HUGGINGFACE_API_KEY=

# Vercel — AI Providers	CLOUDFLARE_API_TOKEN
CLOUDFLARE_API_TOKEN=

# Vercel — AI Providers	CLOUDFLARE_ACCOUNT_ID
CLOUDFLARE_ACCOUNT_ID=

# Vercel — AI Providers	VOYAGE_API_KEY
VOYAGE_API_KEY=

# ------------------------------------------------------------------------------
# 6. VERCEL — QDRANT VECTOR COUPLE MEMORY VAULT
# ------------------------------------------------------------------------------
# Vercel — Qdrant	QDRANT_API_KEY
QDRANT_API_KEY=

# Vercel — Qdrant	QDRANT_CLUSTER_ENDPOINT
QDRANT_CLUSTER_ENDPOINT=https://your-cluster-id.us-east-1-0.aws.cloud.qdrant.io

# Vercel — Qdrant	QDRANT_COLLECTION_NAME
QDRANT_COLLECTION_NAME=little_world_memories

# ------------------------------------------------------------------------------
# 7. VERCEL — UPSTASH QSTASH & REDIS (Daily Reminders & Rate Limiting)
# ------------------------------------------------------------------------------
# Vercel — Upstash QStash	QSTASH_URL
QSTASH_URL=https://qstash.upstash.io

# Vercel — Upstash QStash	QSTASH_TOKEN
QSTASH_TOKEN=

# Vercel — Upstash QStash	QSTASH_CURRENT_SIGNING_KEY
QSTASH_CURRENT_SIGNING_KEY=

# Vercel — Upstash QStash	QSTASH_NEXT_SIGNING_KEY
QSTASH_NEXT_SIGNING_KEY=

# Vercel — Upstash Redis	UPSTASH_REDIS_REST_URL
UPSTASH_REDIS_REST_URL=

# Vercel — Upstash Redis	UPSTASH_REDIS_REST_TOKEN
UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------------------------------
# 8. VERCEL — OBSERVABILITY, LOGS & ANALYTICS (Axiom, Sentry, Umami)
# ------------------------------------------------------------------------------
# Vercel — Observability	AXIOM_TOKEN
AXIOM_TOKEN=

# Vercel — Observability	AXIOM_DATASET
AXIOM_DATASET=a-little-world-production

# Vercel — Observability	SENTRY_DSN
SENTRY_DSN=

# Vercel — Observability	SENTRY_ORG
SENTRY_ORG=

# Vercel — Observability	SENTRY_PROJECT
SENTRY_PROJECT=

# Vercel — Observability	NEXT_PUBLIC_SENTRY_DSN
NEXT_PUBLIC_SENTRY_DSN=

# Vercel — Observability	SENTRY_ENVIRONMENT
SENTRY_ENVIRONMENT=production

# Vercel — Observability	UMAMI_WEBSITE_ID
UMAMI_WEBSITE_ID=

# Vercel — Observability	UMAMI_HOST_URL
UMAMI_HOST_URL=https://cloud.umami.is

# Vercel — Observability	NEXT_PUBLIC_UMAMI_WEBSITE_ID
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vercel — Observability	NEXT_PUBLIC_UMAMI_SCRIPT_URL
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://cloud.umami.is/script.js

# ------------------------------------------------------------------------------
# 9. VERCEL — GOOGLE DRIVE OAUTH (Couple Shared Archive Backup)
# ------------------------------------------------------------------------------
# Vercel — Google Drive	GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=

# Vercel — Google Drive	GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_SECRET=

# Vercel — Google Drive	GOOGLE_DRIVE_REDIRECT_URI
GOOGLE_DRIVE_REDIRECT_URI=https://a-little-world-with-us.vercel.app/api/drive/callback

# Vercel — Google Drive	GOOGLE_DRIVE_REFRESH_TOKEN
GOOGLE_DRIVE_REFRESH_TOKEN=

# Vercel — Google Drive	GOOGLE_DRIVE_FOLDER_ID
GOOGLE_DRIVE_FOLDER_ID=

# Vercel — Google Drive	GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=

# Vercel — Google Drive	GOOGLE_OAUTH_STATE_SECRET
GOOGLE_OAUTH_STATE_SECRET=

# ------------------------------------------------------------------------------
# 10. VERCEL — TELEGRAM BOT & DAILY COUPLE QUESTION PROMPT
# ------------------------------------------------------------------------------
# Vercel — Telegram	TELEGRAM_BOT_TOKEN
TELEGRAM_BOT_TOKEN=

# Vercel — Telegram	TELEGRAM_CHAT_ID
TELEGRAM_CHAT_ID=

# Vercel — Telegram	TELEGRAM_TOPIC_ID
TELEGRAM_TOPIC_ID=

# Vercel — Telegram	TELEGRAM_ENABLED
TELEGRAM_ENABLED=true

# ------------------------------------------------------------------------------
# 11. VERCEL / MOBILE — WEBRTC FREE STUN / TURN RELAY (Metered.ca Free Tier)
# ------------------------------------------------------------------------------
# Vercel / Mobile — WebRTC	NEXT_PUBLIC_TURN_URLS
NEXT_PUBLIC_TURN_URLS=turn:standard.relay.metered.ca:80,turns:standard.relay.metered.ca:443

# Vercel / Mobile — WebRTC	NEXT_PUBLIC_TURN_USERNAME
NEXT_PUBLIC_TURN_USERNAME=

# Vercel / Mobile — WebRTC	NEXT_PUBLIC_TURN_CREDENTIAL
NEXT_PUBLIC_TURN_CREDENTIAL=

# ------------------------------------------------------------------------------
# 12. VERCEL — WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Vercel — Web Push	WEB_PUSH_PUBLIC_KEY
WEB_PUSH_PUBLIC_KEY=

# Vercel — Web Push	WEB_PUSH_PRIVATE_KEY
WEB_PUSH_PRIVATE_KEY=

# Vercel — Web Push	WEB_PUSH_SUBJECT
WEB_PUSH_SUBJECT=mailto:admin@yourdomain.com

# ------------------------------------------------------------------------------
# 13. VERCEL — COUPLE ANNIVERSARY & MILESTONE CONSTANTS
# ------------------------------------------------------------------------------
# Vercel — Optional	NEXT_PUBLIC_GIPHY_API_KEY
NEXT_PUBLIC_GIPHY_API_KEY=

# Vercel — Optional	NEXT_PUBLIC_ANNIVERSARY
NEXT_PUBLIC_ANNIVERSARY=

# Vercel — Optional	NEXT_PUBLIC_COUPLE_START
NEXT_PUBLIC_COUPLE_START=

# ------------------------------------------------------------------------------
# 14. EXPO / MOBILE — CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Expo / Mobile	EXPO_PUBLIC_APP_URL
EXPO_PUBLIC_APP_URL=https://a-little-world-with-us.vercel.app

# Expo / Mobile	EXPO_PUBLIC_SUPABASE_URL
EXPO_PUBLIC_SUPABASE_URL=

# Expo / Mobile	EXPO_PUBLIC_SUPABASE_ANON_KEY
EXPO_PUBLIC_SUPABASE_ANON_KEY=
