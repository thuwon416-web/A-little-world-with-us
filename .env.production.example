# ==============================================================================
# A-LITTLE-WORLD-WITH-US: PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# (Non-Docker Native / Systemd / PM2 Deployment)
#
# Instructions:
# 1. Copy this file to .env or apps/web/.env.local
# 2. Populate all empty values with real production secrets.
# 3. Restrict permissions (chmod 600 .env).
# ==============================================================================

# --- APPLICATION & RUNTIME ---
NODE_ENV=production
PORT=3004
HOST=127.0.0.1
NEXT_PUBLIC_APP_URL=https://world.yourdomain.com
CRON_SECRET=replace-with-random-cron-secret-token

# --- SUPABASE POSTGRESQL & AUTH ---
# Connection pooling / direct PostgreSQL connection for migrations
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?sslmode=require
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# --- END-TO-END CHAT & DATA ENCRYPTION ---
# 64 hex characters (32 bytes). Generate with: openssl rand -hex 32
NEXT_PUBLIC_CHAT_ENCRYPTION_KEY=replace-with-64-hex-char-aes-key
CHAT_ENCRYPTION_KEY=replace-with-64-hex-char-aes-key

# --- GOOGLE DRIVE OAUTH & BACKUP ARCHIVE ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=https://world.yourdomain.com/api/drive/callback
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=replace-with-64-hex-char-key
GOOGLE_OAUTH_STATE_SECRET=replace-with-random-secret

# --- MULTI-PROVIDER AI & KOREAN LEARNING ORCHESTRATION ---
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
HUGGINGFACE_API_KEY=
MISTRAL_API_KEY=
COHERE_API_KEY=
CEREBRAS_API_KEY=
NVIDIA_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
VOYAGE_API_KEY=

# --- CLOUDINARY & BACKBLAZE B2 STORAGE ---
# Primary media assets (Cloudinary)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Large file storage (>50MB Backblaze B2)
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_ID=
B2_BUCKET_NAME=

# --- TELEGRAM BOT ALERTS & INCIDENT REPORTING ---
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_TOPIC_ID=

# --- RATE LIMITING & REDIS (Upstash) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- WEB PUSH NOTIFICATIONS (VAPID) ---
WEB_PUSH_PUBLIC_KEY=
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:admin@yourdomain.com

# --- OBSERVABILITY & SENTRY ---
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENVIRONMENT=production

# --- OPTIONAL FEATURES ---
NEXT_PUBLIC_GIPHY_API_KEY=
NEXT_PUBLIC_ANNIVERSARY=
NEXT_PUBLIC_COUPLE_START=
