# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# App Configuration
NEXT_PUBLIC_APP_NAME=A Little World With Us
NEXT_PUBLIC_APP_URL=https://ourforever.app

# Rate limiting (REQUIRED in production; use an Upstash Redis database)
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token

# AI providers (server-side only; configure only the providers you use)
GEMINI_API_KEY=your-gemini-api-key
OPENROUTER_API_KEY=your-openrouter-api-key
GROQ_API_KEY=your-groq-api-key

# GIF API (for chat)
NEXT_PUBLIC_GIPHY_API_KEY=your-giphy-api-key

# Push Notifications (optional, for background reminders)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key

# Error monitoring (optional)
SENTRY_DSN=your-server-sentry-dsn
NEXT_PUBLIC_SENTRY_DSN=your-client-sentry-dsn
